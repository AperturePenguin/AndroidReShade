# AndroidReShade - Identity LUT (无变化，测试用)
# 32x32x32 3D LUT in .cube format
# 导入方式：adb push identity.cube /sdcard/ReShade/luts/

TITLE "Identity - No Change"
DOMAIN_MIN 0.0 0.0 0.0
DOMAIN_MAX 1.0 1.0 1.0
LUT_3D_SIZE 8

# 8x8x8 = 512 个数据点（R 最快变化，B 最慢）
# 格式：R G B（每行一个样本）

